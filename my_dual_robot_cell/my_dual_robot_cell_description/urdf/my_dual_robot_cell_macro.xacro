<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find my_dual_robot_cell_description)/urdf/ur_macro.xacro"/>
  <xacro:arg name="alice_reverse_port" default="50006"/>
  <xacro:arg name="alice_trajectory_port" default="50009"/>
  <xacro:arg name="alice_script_command_port" default="50002"/>
  <xacro:arg name="alice_script_sender_port" default="50007"/>

  <xacro:arg name="bob_reverse_port" default="50005"/>
  <xacro:arg name="bob_trajectory_port" default="50003"/>
  <xacro:arg name="bob_script_command_port" default="50004"/>
  <xacro:arg name="bob_script_sender_port" default="50008"/>


  <xacro:macro name="my_dual_robot_cell" params="
    parent
    *origin

    alice_ur_type
    alice_joint_limits_parameters_file
    alice_kinematics_parameters_file
    alice_physical_parameters_file
    alice_visual_parameters_file
    alice_reverse_port
    alice_trajectory_port
    alice_script_command_port
    alice_script_sender_port

    bob_ur_type
    bob_joint_limits_parameters_file
    bob_kinematics_parameters_file
    bob_physical_parameters_file
    bob_visual_parameters_file
    bob_reverse_port
    bob_trajectory_port
    bob_script_command_port
    bob_script_sender_port
    ">

    <joint name="table_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="table" />
      <origin xyz="0.0 0.0 0" rpy="0 0 0" />
    </joint>

    <link name="table">
      <visual>
        <geometry>
          <mesh filename="package://my_robot_cell_description/meshes/frame_wo_screw_basetrans_m.dae"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0.0 0.0 0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://my_robot_cell_description/meshes/frame_wo_screw_basetrans_m.stl"/>
        </geometry>
        <origin rpy="0 0 0" xyz="0.0 0.0 0"/>
      </collision>
    </link>



    <!--Creates the mounts to attach the robots to the table-->
    <link name="alice_robot_mount"/>
    <joint name="base_to_alice_robot_mount" type="floating">
      <parent link="table"/>
      <child link="alice_robot_mount"/>
      <origin xyz="-0.25 0.0 0" rpy="0 0 0" />
    </joint>
  
    <link name="bob_robot_mount"/>
    <joint name="base_to_bob_robot_mount" type="floating">
      <parent link="table"/>
      <child link="bob_robot_mount"/>
      <origin xyz="0.25 0.0 0" rpy="0 0 0" />
    </joint>

    <!-- <link name="alice_robot_mount"/>
    <joint name="base_to_alice_robot_mount" type="fixed">
      <parent link="table"/>
      <child link="alice_robot_mount"/>
      <origin xyz="-0.25 0.0 0" rpy="0 0 0" />
    </joint>
  
    <link name="bob_robot_mount"/>
    <joint name="base_to_bob_robot_mount" type="fixed">
      <parent link="table"/>
      <child link="bob_robot_mount"/>
      <origin xyz="0.25 0.0 0" rpy="0 0 0" />
    </joint> -->



    <!--Creates the 1st Robot-->
    <xacro:ur_robot
      name="alice"
      tf_prefix="alice_"
      parent="alice_robot_mount"
      joint_limits_parameters_file="${alice_joint_limits_parameters_file}"
      kinematics_parameters_file="${alice_kinematics_parameters_file}"
      physical_parameters_file="${alice_physical_parameters_file}"
      visual_parameters_file="${alice_visual_parameters_file}"
      generate_ros2_control_tag="false"
      reverse_port="${alice_reverse_port}"
      trajectory_port="${alice_trajectory_port}"
      script_sender_port="${alice_script_sender_port}"
      script_command_port="${alice_script_command_port}"
      
      
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>
  
    <!--Creates the 2nd Robot-->
    <xacro:ur_robot
      name="bob"
      tf_prefix="bob_"
      parent="bob_robot_mount"
      joint_limits_parameters_file="${bob_joint_limits_parameters_file}"
      kinematics_parameters_file="${bob_kinematics_parameters_file}"
      physical_parameters_file="${bob_physical_parameters_file}"
      visual_parameters_file="${bob_visual_parameters_file}"
      generate_ros2_control_tag="false"
      reverse_port="${bob_reverse_port}"
      trajectory_port="${bob_trajectory_port}"
      script_sender_port="${bob_script_sender_port}"
      script_command_port="${bob_script_command_port}"
      
    >
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>

  </xacro:macro>

</robot>
